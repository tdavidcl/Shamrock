CompileFlags:
  Remove: [
      -fsycl,
      -fsycl-targets=*,
      --hipsycl-targets=*,
      --hipsycl-platform=*,
      --hipsycl-config-file=*,
      --hipsycl-cpu-cxx=*,
      --acpp-targets=*,
      # precompiled header (SHAMROCK_USE_PCH) flags: the PCH is built by the project compiler,
      # which may be a different clang version than clangd. They are passed as
      # `-Xclang -include-pch -Xclang <file>.pch -Xclang -include -Xclang <file>`, this keeps only
      # the (textual) `-include <file>`.
      -Xclang,
      -include-pch
    ]
  Add: [
      -Wconversion
    ]

Diagnostics:
  # >= clangd-14
  UnusedIncludes: Strict
  # >= clangd-17
  MissingIncludes: None
  # >=clangd-12 - Enable clang-tidy and read configuration from .clang-tidy
  ClangTidy: {}

Hover:
  # >= clangd-14
  ShowAKA: true

Completion:
  # >= clangd-21
  HeaderInsertion: Never

Documentation:
  # >= clangd-22
  CommentFormat: Doxygen
